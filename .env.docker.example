# ============================================================
# qiyu-live-app 本机 Docker 部署环境变量样例
# 使用说明：
#   1. 复制本文件为 .env.docker（该文件已在 .gitignore 中，不会提交 Git）
#   2. 把所有 replace-me 替换为真实值
# ============================================================

# ---------- 镜像版本 ----------
MONGODB_IMAGE=mongo:7.0

# ---------- MongoDB 容器 root 账号 ----------
MONGODB_ROOT_USERNAME=root
MONGODB_ROOT_PASSWORD=replace-me

# 可选：本机调试 MongoDB 时暴露到宿主机的端口（默认不映射，本机 27017 已被 Windows MongoDB 占用）
# MONGODB_HOST_PORT=27018

# ---------- MySQL（复用 mysql-master 容器，业务主库） ----------
QIYU_MYSQL_USERNAME=root
QIYU_MYSQL_PASSWORD=replace-me

# ---------- Nacos（宿主机本机服务，端口 8848） ----------
NACOS_USERNAME=nacos
NACOS_PASSWORD=replace-me

# ---------- Redis（复用 redis-qiyu 容器，默认无密码） ----------
# 若 Redis 设置了密码，取消下面注释并填写
# SPRING_DATA_REDIS_PASSWORD=replace-me

# ---------- 支付宝沙箱（只配置在本机 .env.docker 或 Nacos，禁止提交） ----------
QIYU_ALIPAY_APP_ID=replace-me
QIYU_ALIPAY_APP_PRIVATE_KEY=replace-me
QIYU_ALIPAY_PUBLIC_KEY=replace-me
QIYU_ALIPAY_NOTIFY_URL=https://your-public-domain.example.com/payNotify/alipay-notify
QIYU_ALIPAY_RETURN_URL=http://localhost:5173/recharge-result
